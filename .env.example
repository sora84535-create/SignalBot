# ═══════════════════════════════════════════════════════
#  MEXC Signal Bot — Environment Variables
#  Copy this to Railway → Settings → Variables
# ═══════════════════════════════════════════════════════

# ── REQUIRED ─────────────────────────────────────────
# Your Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat/channel ID where signals are sent
# Get it from @userinfobot or @getidsbot
TELEGRAM_CHAT_ID=your_chat_id_here

# ── MEXC API (optional — for account features) ───────
# From MEXC → Account → API Management
MEXC_API_KEY=
MEXC_API_SECRET=

# ── AI ASSISTANT (required for /ai command) ──────────
# Free at: https://console.groq.com/
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── NEWS (optional but recommended) ─────────────────
# Free at: https://newsapi.org/ (100 req/day free)
NEWS_API_KEY=

# Free at: https://cryptopanic.com/developers/api/
CRYPTOPANIC_KEY=

# ── SIGNAL SETTINGS ──────────────────────────────────
# Minimum confluence score to fire a signal (0-100)
MIN_CONFLUENCE_SCORE=65

# Cooldown between signals for same coin (minutes)
SIGNAL_COOLDOWN_MIN=15

# Minimum spread % to alert (MEXC vs DEX)
MIN_SPREAD_PCT=10.0

# ── INTERVALS (seconds) ──────────────────────────────
SIGNAL_SCAN_INTERVAL=300
NEWS_SCAN_INTERVAL=600
SPREAD_SCAN_SEC=120

# ── MISC ─────────────────────────────────────────────
LOG_LEVEL=INFO
DEBUG=false
TIMEZONE=UTC
